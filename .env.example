# Shiprocket Shipping API user (never use the merchant login password here)
SHIPROCKET_API_BASE_URL=https://apiv2.shiprocket.in/v1/external
SHIPROCKET_API_EMAIL=
SHIPROCKET_API_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=
SHIPROCKET_PICKUP_POSTCODE=
SHIPROCKET_WEBHOOK_TOKEN=
SHIPROCKET_DEFAULT_PACKAGE_LENGTH_CM=30
SHIPROCKET_DEFAULT_PACKAGE_BREADTH_CM=22
SHIPROCKET_DEFAULT_PACKAGE_HEIGHT_CM=5

# Fastrr Checkout values supplied during merchant onboarding
FASTRR_CREATE_SESSION_URL=
FASTRR_MERCHANT_ID=
FASTRR_PUBLIC_KEY=
FASTRR_SECRET_KEY=
FASTRR_WEBHOOK_SECRET=
FASTRR_WEBHOOK_SIGNATURE_HEADER=X-Fastrr-Signature
FASTRR_SUCCESS_URL=https://your-store.example/track-order
FASTRR_CANCEL_URL=https://your-store.example/checkout
